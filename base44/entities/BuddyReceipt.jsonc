{
  "name": "BuddyReceipt",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "buddy_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "why_chosen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "used_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes_made": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmation": {
      "type": "string"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_time_saved_minutes": {
      "type": "number",
      "description": "Legacy field retained for compatibility. Buddy does not display or claim estimated time savings unless a future measured source populates it."
    }
  },
  "required": [
    "owner_id",
    "buddy_id",
    "title",
    "completed_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "data.owner_id": "{{user.id}}"
    }
  }
}