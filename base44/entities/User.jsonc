{
  "name": "User",
  "properties": {
    "notify_email": {
      "default": false,
      "description": "Email me the answers \u2014 when a note finds something, send the findings to the account email.",
      "type": "boolean"
    },
    "plan": {
      "default": "free",
      "description": "Whether the user has Pro: 'pro' or 'free'. Set by the payments webhook when a subscription is approved, and revoked when it ends.",
      "enum": [
        "free",
        "pro"
      ],
      "type": "string"
    },
    "role": {
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ],
      "type": "string"
    },
    "sms_phone": {
      "description": "Mirror of the user's confirmed E.164 phone number. Delivery code must verify ownership through PhoneIdentity before using this value.",
      "type": "string"
    },
    "timezone": {
      "description": "IANA timezone of the person (like America/New_York), read from their browser. A note that says 9 in the morning means their morning, so the hourly sweep runs on this clock.",
      "type": "string"
    },
    "meta_token": {
      "description": "Meta (Facebook) access token the person pasted in Settings, with ads_read / ads_management / pages_manage_posts permission. Empty means no Meta connection.",
      "type": "string"
    },
    "meta_ad_account": {
      "description": "The Meta ad account to act on, like act_1234567890. Picked automatically on connect unless the person chooses one.",
      "type": "string"
    },
    "meta_page_id": {
      "description": "The Facebook Page social notes post to. Picked automatically on connect unless the person chooses one.",
      "type": "string"
    }
  },
  "required": [
    "role"
  ],
  "type": "object"
}