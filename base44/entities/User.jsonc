{
  "name": "User",
  "properties": {
    "notify_email": {
      "default": false,
      "description": "Email me the answers \u2014 when a note finds something, send the findings to the account email.",
      "type": "boolean"
    },
    "plan": {
      "default": "free",
      "description": "Whether the user has Pro: 'pro' or 'free'. Set by the payments webhook when a subscription is approved, and revoked when it ends.",
      "enum": [
        "free",
        "pro"
      ],
      "type": "string"
    },
    "role": {
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ],
      "type": "string"
    },
    "sms_phone": {
      "description": "Phone number in E.164 form (like +15551234567) that notes text their findings to. Empty means texts are off.",
      "type": "string"
    },
    "timezone": {
      "description": "IANA timezone of the person (like America/New_York), read from their browser. A note that says 9 in the morning means their morning, so the hourly sweep runs on this clock.",
      "type": "string"
    }
  },
  "required": [
    "role"
  ],
  "type": "object"
}