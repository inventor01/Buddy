{
  "name": "HouseholdProfile",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "household_name": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "shared_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "owner_id"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "data.owner_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_id": "{{user.id}}"
    }
  }
}