{
  "name": "Buddy",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "App user who owns this Buddy record. Explicit because service-role creates do not preserve created_by_id as the end user."
    },
    "kind": {
      "type": "string",
      "enum": [
        "web",
        "ads",
        "social"
      ],
      "default": "web",
      "description": "What kind of job this note does: web = search the web every day, ads = watch and manage the person's Facebook & Instagram ad account, social = post on and run the person's Facebook Page"
    },
    "run_mode": {
      "type": "string",
      "enum": [
        "once",
        "watch",
        "repeat"
      ],
      "default": "watch",
      "description": "How this thing behaves: once = handle it now and finish, watch = keep checking until something matters, repeat = do it on a recurring schedule"
    },
    "capability": {
      "type": "string",
      "enum": [
        "web",
        "gmail",
        "calendar",
        "tasks"
      ],
      "default": "web",
      "description": "Which outside ability this thing needs. Consumer UI should describe the outcome, not this technical value."
    },
    "action_type": {
      "type": "string",
      "enum": [
        "none",
        "email_read",
        "email_send",
        "calendar_read",
        "calendar_create",
        "task_create"
      ],
      "default": "none",
      "description": "Structured outside action, if any. Write actions are always approval-gated."
    },
    "action_payload": {
      "type": "object",
      "properties": {
        "recipient": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "due": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "in_reply_to": {
          "type": "string"
        }
      },
      "description": "Bounded structured details used to preview and, after approval, carry out a connected action."
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "not_needed",
        "pending",
        "approved",
        "executing",
        "rejected",
        "executed",
        "failed",
        "needs_connection"
      ],
      "default": "not_needed",
      "description": "Safety gate for actions that change something outside Buddy."
    },
    "execution_token": {
      "type": "string",
      "description": "Unique token proving which request owns an in-flight approved action; cleared when the action finishes or fails. Prevents a concurrent double-click from sending the outside action twice."
    },
    "run_lock_at": {
      "type": "string",
      "description": "ISO timestamp of the in-flight run lock; empty when idle. A stale lock self-heals after the TTL."
    },
    "run_token": {
      "type": "string",
      "description": "Unique token proving which worker owns the current run lock."
    },
    "client_token": {
      "type": "string",
      "description": "Client-generated id for one create intent; a replayed create returns the original record instead of a duplicate."
    },
    "deferred_action": {
      "type": "boolean",
      "default": false,
      "description": "True when a write must wait for a user choice or missing dependency before approval can be requested."
    },
    "linked_buddy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other owner-scoped Buddy threads explicitly referenced with @ and allowed to contribute context."
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "single",
        "chain"
      ],
      "default": "single",
      "description": "Whether this handoff is one unit of work or an ordered dependency chain."
    },
    "task_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "research",
              "review",
              "prepare_message",
              "send_email",
              "handle_responses",
              "action",
              "verify"
            ]
          },
          "instruction": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval_required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "waiting_approval",
              "waiting_response",
              "failed"
            ]
          }
        }
      },
      "description": "Ordered steps for a complex handoff. Each later step consumes the completed output of its dependencies."
    },
    "chain_state": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string"
        },
        "gmail_thread_id": {
          "type": "string"
        },
        "gmail_message_count": {
          "type": "number"
        },
        "last_checked_at": {
          "type": "string"
        }
      },
      "description": "Small server-managed cursor for multi-step connected handoffs such as send then check replies."
    },
    "note": {
      "type": "string",
      "description": "The original one-sentence note the user pinned"
    },
    "image_url": {
      "type": "string",
      "description": "Photo pinned to the note \u2014 searched every day like a reverse image search"
    },
    "name": {
      "type": "string",
      "description": "Friendly note title, e.g. Cheap chicken"
    },
    "creature": {
      "type": "string",
      "enum": [
        "sam",
        "sid",
        "bells",
        "med"
      ],
      "default": "sam",
      "description": "Which garden creature this note was hatched as"
    },
    "when_line": {
      "type": "string",
      "description": "Plain-English line: when it happens"
    },
    "what_line": {
      "type": "string",
      "description": "Plain-English line: what it does"
    },
    "how_line": {
      "type": "string",
      "description": "Plain-English line: how it tells you"
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Details the user gave when it asked \u2014 folded into every run"
    },
    "open_question": {
      "type": "string",
      "description": "A question it asked that's still waiting on the user's answer"
    },
    "arbitrage_leads": {
      "type": "array",
      "description": "Recent one-sided arbitrage candidates Buddy should try to finish verifying on the next run before starting over.",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string"
          },
          "retailer": {
            "type": "string"
          },
          "marketplace": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "original_price": {
            "type": "number"
          },
          "buy_price": {
            "type": "number"
          },
          "price_status": {
            "type": "string"
          },
          "discount_amount": {
            "type": "number"
          },
          "discount_description": {
            "type": "string"
          },
          "discounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "effective_amount": {
                  "type": "number"
                },
                "source_url": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "eligibility": {
                  "type": "string"
                },
                "stackable_with_current_price": {
                  "type": "boolean"
                },
                "stackable_with_other_offers": {
                  "type": "boolean"
                },
                "applies_to_exact_item": {
                  "type": "boolean"
                },
                "expires_at": {
                  "type": "string"
                }
              }
            }
          },
          "net_buy_cost": {
            "type": "number"
          },
          "resale_price": {
            "type": "number"
          },
          "buy_url": {
            "type": "string"
          },
          "resale_url": {
            "type": "string"
          },
          "missing_evidence": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "last_seen_at": {
            "type": "string"
          }
        }
      }
    },
    "arbitrage_leads_updated_at": {
      "type": "string",
      "description": "ISO timestamp for the most recent unresolved arbitrage lead refresh."
    },
    "schedule_time": {
      "type": "string",
      "description": "The time it runs, e.g. 9:00 AM"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "done"
      ],
      "default": "active"
    },
    "last_result": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The latest findings pinned back by this note"
    },
    "last_run_date": {
      "type": "string",
      "description": "Date (YYYY-MM-DD) the note last ran, so it never runs twice in one day"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "enum": [
              "note",
              "you"
            ],
            "description": "Who said it: the note, or you"
          },
          "at": {
            "type": "string",
            "description": "ISO date when it was said"
          },
          "text": {
            "type": "string",
            "description": "What was said"
          },
          "items": {
            "type": "array",
            "description": "Structured findings for this reply: the sentence plus its source, with product details when the finding is a product",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "why_fit": {
                  "type": "string"
                },
                "deal": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "type": "string"
                    },
                    "zip_code": {
                      "type": "string"
                    },
                    "property_type": {
                      "type": "string"
                    },
                    "list_price": {
                      "type": "number"
                    },
                    "arv": {
                      "type": "number"
                    },
                    "arv_low": {
                      "type": "number"
                    },
                    "arv_high": {
                      "type": "number"
                    },
                    "repairs": {
                      "type": "number"
                    },
                    "repair_basis": {
                      "type": "string"
                    },
                    "flipper_max": {
                      "type": "number"
                    },
                    "max_contract": {
                      "type": "number"
                    },
                    "assignment_fee": {
                      "type": "number"
                    },
                    "investor_arv_percent": {
                      "type": "number"
                    },
                    "deal_score": {
                      "type": "number"
                    },
                    "days_on_market": {
                      "type": "number"
                    },
                    "price_cuts": {
                      "type": "number"
                    },
                    "listing_type": {
                      "type": "string"
                    },
                    "square_footage": {
                      "type": "number"
                    },
                    "bedrooms": {
                      "type": "number"
                    },
                    "bathrooms": {
                      "type": "number"
                    },
                    "listing_url": {
                      "type": "string"
                    },
                    "listing_source": {
                      "type": "string"
                    },
                    "image_url": {
                      "type": "string"
                    },
                    "caveat": {
                      "type": "string"
                    },
                    "comps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "address": {
                            "type": "string"
                          },
                          "price": {
                            "type": "number"
                          },
                          "distance": {
                            "type": "number"
                          },
                          "correlation": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                },
                "product": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "image_url": {
                      "type": "string"
                    },
                    "price": {
                      "type": "string"
                    },
                    "stock": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                },
                "arbitrage": {
                  "type": "object",
                  "properties": {
                    "item_name": {
                      "type": "string"
                    },
                    "retailer": {
                      "type": "string"
                    },
                    "marketplace": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string"
                    },
                    "brand": {
                      "type": "string"
                    },
                    "actionability_score": {
                      "type": "number"
                    },
                    "action_tier": {
                      "type": "string"
                    },
                    "units_to_target": {
                      "type": "number"
                    },
                    "match_confidence": {
                      "type": "number"
                    },
                    "demand_note": {
                      "type": "string"
                    },
                    "original_price": {
                      "type": "number"
                    },
                    "buy_price": {
                      "type": "number"
                    },
                    "price_status": {
                      "type": "string"
                    },
                    "discount_amount": {
                      "type": "number"
                    },
                    "discount_description": {
                      "type": "string"
                    },
                    "discounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "effective_amount": {
                            "type": "number"
                          },
                          "source_url": {
                            "type": "string"
                          },
                          "code": {
                            "type": "string"
                          },
                          "eligibility": {
                            "type": "string"
                          },
                          "stackable_with_current_price": {
                            "type": "boolean"
                          },
                          "stackable_with_other_offers": {
                            "type": "boolean"
                          },
                          "applies_to_exact_item": {
                            "type": "boolean"
                          },
                          "expires_at": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "coupon_dependent": {
                      "type": "boolean"
                    },
                    "profit_without_extra_discounts": {
                      "type": "number"
                    },
                    "net_buy_cost": {
                      "type": "number"
                    },
                    "resale_price": {
                      "type": "number"
                    },
                    "estimated_fees": {
                      "type": "number"
                    },
                    "estimated_profit": {
                      "type": "number"
                    },
                    "roi_percent": {
                      "type": "number"
                    },
                    "buy_url": {
                      "type": "string"
                    },
                    "resale_url": {
                      "type": "string"
                    },
                    "caveat": {
                      "type": "string"
                    }
                  }
                },
                "arbitrage_lead": {
                  "type": "object",
                  "properties": {
                    "item_name": {
                      "type": "string"
                    },
                    "retailer": {
                      "type": "string"
                    },
                    "marketplace": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string"
                    },
                    "brand": {
                      "type": "string"
                    },
                    "identifier": {
                      "type": "string"
                    },
                    "original_price": {
                      "type": "number"
                    },
                    "buy_price": {
                      "type": "number"
                    },
                    "price_status": {
                      "type": "string"
                    },
                    "discount_amount": {
                      "type": "number"
                    },
                    "discount_description": {
                      "type": "string"
                    },
                    "discounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "effective_amount": {
                            "type": "number"
                          },
                          "source_url": {
                            "type": "string"
                          },
                          "code": {
                            "type": "string"
                          },
                          "eligibility": {
                            "type": "string"
                          },
                          "stackable_with_current_price": {
                            "type": "boolean"
                          },
                          "stackable_with_other_offers": {
                            "type": "boolean"
                          },
                          "applies_to_exact_item": {
                            "type": "boolean"
                          },
                          "expires_at": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "net_buy_cost": {
                      "type": "number"
                    },
                    "resale_price": {
                      "type": "number"
                    },
                    "buy_url": {
                      "type": "string"
                    },
                    "resale_url": {
                      "type": "string"
                    },
                    "missing_evidence": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "confidence": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "who",
          "at",
          "text"
        ]
      }
    }
  },
  "required": [
    "note",
    "name",
    "creature"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "data.owner_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_id": "{{user.id}}"
    }
  }
}