{
  "name": "Buddy",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "web",
        "ads",
        "social"
      ],
      "default": "web",
      "description": "What kind of job this note does: web = search the web every day, ads = watch and manage the person's Facebook & Instagram ad account, social = post on and run the person's Facebook Page"
    },
    "run_mode": {
      "type": "string",
      "enum": [
        "once",
        "watch",
        "repeat"
      ],
      "default": "watch",
      "description": "How this thing behaves: once = handle it now and finish, watch = keep checking until something matters, repeat = do it on a recurring schedule"
    },
    "note": {
      "type": "string",
      "description": "The original one-sentence note the user pinned"
    },
    "image_url": {
      "type": "string",
      "description": "Photo pinned to the note \u2014 searched every day like a reverse image search"
    },
    "name": {
      "type": "string",
      "description": "Friendly note title, e.g. Cheap chicken"
    },
    "creature": {
      "type": "string",
      "enum": [
        "sam",
        "sid",
        "bells",
        "med"
      ],
      "default": "sam",
      "description": "Which garden creature this note was hatched as"
    },
    "when_line": {
      "type": "string",
      "description": "Plain-English line: when it happens"
    },
    "what_line": {
      "type": "string",
      "description": "Plain-English line: what it does"
    },
    "how_line": {
      "type": "string",
      "description": "Plain-English line: how it tells you"
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Details the user gave when it asked for more \u2014 folded into every run"
    },
    "open_question": {
      "type": "string",
      "description": "A question it asked that's still waiting on the user's answer"
    },
    "schedule_time": {
      "type": "string",
      "description": "The time it runs, e.g. 9:00 AM"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "done"
      ],
      "default": "active"
    },
    "last_result": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The latest findings pinned back by this note"
    },
    "last_run_date": {
      "type": "string",
      "description": "Date (YYYY-MM-DD) the note last ran, so it never runs twice in one day"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "enum": [
              "note",
              "you"
            ],
            "description": "Who said it: the note, or you"
          },
          "at": {
            "type": "string",
            "description": "ISO date when it was said"
          },
          "text": {
            "type": "string",
            "description": "What was said"
          },
          "items": {
            "type": "array",
            "description": "Structured findings for this reply: the sentence plus its source, with product details when the finding is a product",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "product": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "image_url": {
                      "type": "string"
                    },
                    "price": {
                      "type": "string"
                    },
                    "stock": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "who",
          "at",
          "text"
        ]
      }
    }
  },
  "required": [
    "note",
    "name",
    "creature"
  ]
}